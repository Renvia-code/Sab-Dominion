### proxy MED days per year
SELECT year(day) AS year, SUM(CASE WHEN is_med_proxy THEN 1 ELSE 0 END) AS med_days,
       ROUND(MAX(med_threshold_customer_hours)) AS threshold FROM mart.FCT_TERRITORY_DAY GROUP BY 1 ORDER BY 1

